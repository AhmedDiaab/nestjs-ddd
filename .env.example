# ─── Application ───────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=

# ─── Logging ───────────────────────────────────────────────────
# debug | info | warn | error (default info)
LOG_LEVEL=
# include stack in error logs (default false)
SHOW_STACK_TRACES=
# default x-request-id
REQUEST_ID_HEADER=
# default true
LOGGING_TO_FILE=
# default logs
LOGGING_DIR=
# default app.log
LOGGING_FILE_NAME=
# rolled files kept (default 14)
LOGGING_FILES_LIMIT=
# per file, e.g. 10m, 1g (default 10m)
LOGGING_MAX_SIZE=
# default: true in development only
LOGGING_PRETTY=

# ─── HTTP ──────────────────────────────────────────────────────
# default 3000
PORT=
# comma-separated allow-list; empty = CORS disabled
CORS_ORIGINS=
# ms (default 120000)
SERVER_TIMEOUT=
# ms (default 121000)
HEADERS_TIMEOUT=
# ms (default 61000)
KEEP_ALIVE_TIMEOUT=
# default 1mb
JSON_BODY_LIMIT=
# default 1mb
URLENCODED_BODY_LIMIT=
# default: off in production, on elsewhere
SWAGGER_ENABLED=
# rate-limit window (default 60000)
THROTTLE_TTL_MS=
# requests per window per IP; 0 disables (default 100)
THROTTLE_LIMIT=
# memory (per instance, default) | redis (shared by all instances)
THROTTLE_STORAGE=
# required when THROTTLE_STORAGE=redis, e.g. redis://:password@redis-host:6379/0
THROTTLE_REDIS_URL=
# true behind a load balancer (real client IP for throttling)
TRUST_PROXY=
# reject cross-site writes authenticated by the JWT cookie (default true)
CSRF_ENABLED=
# comma-separated origins allowed to send cookie-authenticated writes (default: CORS_ORIGINS)
CSRF_TRUSTED_ORIGINS=

# ─── TLS ───────────────────────────────────────────────────────
# Off by default: a load balancer/VIP usually terminates TLS instead (docs/architecture/operations.md § TLS).
# Only turn this on when nothing sits in front of the process, e.g. the Windows service install.
# default false
TLS_ENABLED=
# path to the PEM private key; required when TLS_ENABLED=true
TLS_KEY_FILE=
# path to the PEM certificate (chain); required when TLS_ENABLED=true
TLS_CERT_FILE=
# path to an extra PEM trust chain; optional even when enabled
TLS_CA_FILE=
# decrypts an encrypted private key; leave unset for an unencrypted one
TLS_PASSPHRASE=
# TLSv1.2 | TLSv1.3 (default TLSv1.2)
TLS_MIN_VERSION=

# ─── Idempotency (@Idempotent() routes) ────────────────────────
# memory (per instance, default) | oracle (shared, survives a restart)
IDEMPOTENCY_STORE=
# Oracle only; must match /^[A-Za-z][A-Za-z0-9_]{0,29}$/ (default IDEMPOTENCY_KEYS)
IDEMPOTENCY_TABLE=
# how long a claimed key is remembered at all, ms (default 86400000 = 24h)
IDEMPOTENCY_TTL_MS=
# how long an in-progress claim is honoured before it's treated as abandoned, ms (default 60000)
IDEMPOTENCY_IN_PROGRESS_TTL_MS=
# header carrying the client-supplied key (default idempotency-key)
IDEMPOTENCY_HEADER=

# ─── Metrics ───────────────────────────────────────────────────
# expose GET /metrics for Prometheus (default false; keep the port internal)
METRICS_ENABLED=
# include Node/process metrics: heap, event loop lag, GC (default true)
METRICS_DEFAULT_METRICS=

# ─── Shutdown ──────────────────────────────────────────────────
# keep failing readiness this long before closing the server (default 5000)
# must exceed the load balancer's health-check interval x unhealthy threshold
SHUTDOWN_DRAIN_DELAY_MS=
# in-flight requests get this long before their connections are cut (default 10000)
SHUTDOWN_FORCE_AFTER_MS=
# time an in-flight cron job gets to finish before the database pools close (default 10000)
SHUTDOWN_JOB_DRAIN_MS=

# ─── Outbound HTTP (calls to other services) ───────────────────
# per-attempt timeout in ms (default 5000)
HTTP_CLIENT_TIMEOUT_MS=
# extra attempts after the first, for calls that are safe to repeat (default 2)
HTTP_CLIENT_RETRIES=
# backoff for retries, in ms (defaults 200 / 150 / 5000)
HTTP_CLIENT_RETRY_BASE_MS=
HTTP_CLIENT_RETRY_JITTER_MS=
HTTP_CLIENT_RETRY_MAX_DELAY_MS=
# stop calling an upstream that keeps failing (default true)
HTTP_CLIENT_CIRCUIT_ENABLED=
# consecutive failures that open the circuit, and how long it stays open (defaults 5 / 30000)
HTTP_CLIENT_CIRCUIT_FAILURE_THRESHOLD=
HTTP_CLIENT_CIRCUIT_RESET_MS=
# User-Agent sent upstream (default: the project name)
HTTP_CLIENT_USER_AGENT=

# ─── Scheduler ─────────────────────────────────────────────────
# run cron jobs in this instance (default false; enable on one instance only)
SCHEDULER_ENABLED=
# IANA timezone for cron expressions (default UTC)
SCHEDULER_TIMEZONE=

# ─── JWT (verification) ────────────────────────────────────────
# required, min 32 chars
JWT_SECRET=
# comma-separated (default HS256)
JWT_ALGORITHMS=
JWT_ISSUER=
JWT_AUDIENCE=
# default jwt (Authorization: Bearer also accepted)
JWT_COOKIE_NAME=

# ─── Database ──────────────────────────────────────────────────
# Unset = no database. JSON array of sources (or {"sources":[...]}).
# Keep comments on their own lines: docker/compose env files treat "KEY=  # text" as the value.
# Keep secrets out of the JSON with "passwordEnv": "<ENV_VAR_NAME>".
# Wrap the JSON in single quotes: unquoted values are cut at the first '#'.
# Minimal oracle source:
#   '[{"key":"main","dialect":"oracle","connectString":"db-host:1521/SERVICE","user":"app","passwordEnv":"MAIN_DB_PASSWORD"}]'
# All oracle options (defaults shown) are documented in README §7.2.
DATABASE_CONFIG_JSON=
MAIN_DB_PASSWORD=

# default true
DATABASE_PING_ON_BOOT=
# default 3000
DATABASE_PING_TIMEOUT_MS=
# default 2
DATABASE_PING_MAX_RETRIES=
# comma-separated keys; default = all implemented sources
DATABASE_PING_REQUIRED_SOURCES=
# default 3
DATABASE_PING_CONCURRENCY=
# default 250
DATABASE_PING_JITTER_MS=
# default false
DATABASE_USE_DBLINK=

# Oracle driver (process-wide)
# default false (thin, no Instant Client needed)
ORACLE_THICK_MODE=
# Instant Client dir (thick mode)
ORACLE_CLIENT_LIB_DIR=
# tnsnames.ora / sqlnet.ora dir (thick mode)
ORACLE_CLIENT_CONFIG_DIR=
# e.g. CLOB,NCLOB,NUMBER,DATE,JSON
ORACLE_FETCH_AS_STRING=
# BLOB
ORACLE_FETCH_AS_BUFFER=
