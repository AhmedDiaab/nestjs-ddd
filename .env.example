# ─── Application ───────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=                 # debug | info | warn | error (default info)
SHOW_STACK_TRACES=         # include stack in error logs (default false)
REQUEST_ID_HEADER=         # default x-request-id
LOGGING_TO_FILE=           # default true
LOGGING_DIR=               # default logs
LOGGING_FILE_NAME=         # default app.log
LOGGING_FILES_LIMIT=       # rolled files kept (default 14)
LOGGING_MAX_SIZE=          # per file, e.g. 10m, 1g (default 10m)
LOGGING_PRETTY=            # default: true in development only

# ─── HTTP ──────────────────────────────────────────────────────
PORT=                      # default 3000
CORS_ORIGINS=              # comma-separated allow-list; empty = CORS disabled
SERVER_TIMEOUT=            # ms (default 120000)
HEADERS_TIMEOUT=           # ms (default 121000)
KEEP_ALIVE_TIMEOUT=        # ms (default 61000)
JSON_BODY_LIMIT=           # default 1mb
URLENCODED_BODY_LIMIT=     # default 1mb
SWAGGER_ENABLED=           # default: off in production, on elsewhere
THROTTLE_TTL_MS=           # rate-limit window (default 60000)
THROTTLE_LIMIT=            # requests per window per IP; 0 disables (default 100)
TRUST_PROXY=               # true behind a load balancer (real client IP for throttling)

# ─── JWT (verification) ────────────────────────────────────────
JWT_SECRET=                # required, min 32 chars
JWT_ALGORITHMS=            # comma-separated (default HS256)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_COOKIE_NAME=           # default jwt (Authorization: Bearer also accepted)

# ─── Database ──────────────────────────────────────────────────
# Unset = no database. JSON array of sources (or {"sources":[...]}).
# Keep secrets out of the JSON with "passwordEnv": "<ENV_VAR_NAME>".
# Wrap the JSON in single quotes: unquoted values are cut at the first '#'.
# Minimal oracle source:
#   '[{"key":"main","dialect":"oracle","connectString":"db-host:1521/SERVICE","user":"app","passwordEnv":"MAIN_DB_PASSWORD"}]'
# All oracle options (defaults shown) are documented in README §7.2.
DATABASE_CONFIG_JSON=
MAIN_DB_PASSWORD=

DATABASE_PING_ON_BOOT=           # default true
DATABASE_PING_TIMEOUT_MS=        # default 3000
DATABASE_PING_MAX_RETRIES=       # default 2
DATABASE_PING_REQUIRED_SOURCES=  # comma-separated keys; default = all implemented sources
DATABASE_PING_CONCURRENCY=       # default 3
DATABASE_PING_JITTER_MS=         # default 250
DATABASE_USE_DBLINK=             # default false

# Oracle driver (process-wide)
ORACLE_THICK_MODE=               # default false (thin, no Instant Client needed)
ORACLE_CLIENT_LIB_DIR=           # Instant Client dir (thick mode)
ORACLE_CLIENT_CONFIG_DIR=        # tnsnames.ora / sqlnet.ora dir (thick mode)
ORACLE_FETCH_AS_STRING=          # e.g. CLOB,NCLOB,NUMBER,DATE,JSON
ORACLE_FETCH_AS_BUFFER=          # BLOB
