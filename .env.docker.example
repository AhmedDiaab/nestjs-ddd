# Copy to .env.docker (gitignored) and fill in. Used only by docker compose:
#   docker compose --env-file .env.docker up --build
#
# Keep comments on their own lines: compose treats "KEY=  # text" as the value "# text".

# ---- API ----
API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# required, at least 32 characters
JWT_SECRET=
# comma-separated allow-list; empty disables CORS
CORS_ORIGINS=
SWAGGER_ENABLED=true
THROTTLE_LIMIT=100
DB_POOL_MAX=5

# ---- Oracle Database Free container ----
ORACLE_PORT=1521
# required: SYS/SYSTEM password
ORACLE_PASSWORD=
ORACLE_APP_USER=app
# required: application schema password
ORACLE_APP_PASSWORD=
